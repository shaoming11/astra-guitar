{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/tunefinder-1.0.schema.json",
  "title": "tunefinder/1.0",
  "description": "A timed monophonic melody transcription with guitar string/fret placement.",
  "type": "object",
  "required": ["format", "source", "instrument", "timing", "notes", "tab", "string_tab"],
  "properties": {
    "format": { "const": "tunefinder/1.0" },
    "generated_utc": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "instrument": { "type": "object" },
    "timing": { "type": "object", "required": ["tempo_bpm", "clock"] },
    "stats": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "tab": { "type": "string" },
    "string_tab": { "type": "string" },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["note_id", "onset_s", "duration_s", "midi", "string", "fret", "string_fret"],
        "properties": {
          "note_id": { "type": "string" },
          "group": { "type": "integer", "minimum": 0 },
          "onset_s": { "type": "number", "minimum": 0 },
          "duration_s": { "type": "number", "exclusiveMinimum": 0 },
          "beat": { "type": ["number", "null"] },
          "measure": { "type": ["integer", "null"] },
          "midi": { "type": "integer", "minimum": 0, "maximum": 127 },
          "pitch": { "type": "string" },
          "freq_hz": { "type": "number", "exclusiveMinimum": 0 },
          "string": { "type": "integer", "minimum": 0 },
          "string_label": { "type": "string" },
          "fret": { "type": "integer", "minimum": 0 },
          "string_fret": { "type": "string" },
          "finger": { "type": "integer", "minimum": 0, "maximum": 4 },
          "open": { "type": "boolean" },
          "velocity": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
